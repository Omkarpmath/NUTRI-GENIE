# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/nutrigenie
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nutrigenie
MONGODB_URI=mongodb://localhost:27017/nutrigenie

# Google Gemini API Key
# Get your key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (use a random string for security)
SESSION_SECRET=your_super_secret_random_string_change_this_in_production
