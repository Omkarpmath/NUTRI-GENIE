# MongoDB Connection
# For local MongoDB: 
#   MONGODB_URI=mongodb://localhost:27017/nutrigenie
#
# For MongoDB Atlas (recommended):
#   Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
#   Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/nutrigenie?retryWrites=true&w=majority
#   
#   Important: 
#   - Replace <username> with your MongoDB Atlas username
#   - Replace <password> with your MongoDB Atlas password (API key)
#   - Replace <cluster-url> with your cluster URL (e.g., cluster0.xxxxx.mongodb.net)
#   - Ensure your IP is whitelisted in MongoDB Atlas Network Access
MONGODB_URI=mongodb://localhost:27017/nutrigenie

# Google Gemini API Key
# Get your key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (use a random string for security)
SESSION_SECRET=your_super_secret_random_string_change_this_in_production
