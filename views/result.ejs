<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Personalized Plan - Nutri-Genie</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap"
        rel="stylesheet">

    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3 {
            font-family: 'Outfit', sans-serif;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeIn 0.6s ease-out;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-purple-50 via-pink-50 to-blue-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <div class="w-10 h-10 gradient-bg rounded-lg flex items-center justify-center">
                        <span class="text-2xl">🧞</span>
                    </div>
                    <span class="text-xl font-bold gradient-text">Nutri-Genie</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/input" class="text-purple-600 hover:text-purple-800 font-medium">New Plan</a>
                    <a href="/dashboard" class="text-purple-600 hover:text-purple-800 font-medium">Dashboard</a>
                    <a href="/logout" class="text-gray-500 hover:text-gray-700">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="text-center mb-12 fade-in">
            <div class="inline-block px-6 py-2 bg-green-100 text-green-700 rounded-full font-semibold mb-4">
                ✅ Plan Generated Successfully!
            </div>
            <h1 class="text-5xl md:text-6xl font-black text-gray-900 mb-4">
                Your <span class="gradient-text">Personalized</span> Health Plan
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Based on your unique profile, here's your AI-powered roadmap to achieving your
                <strong>
                    <%= goalType.replace('_', ' ' ) %>
                </strong> goal
            </p>
        </div>

        <!-- Metabolic Stats -->
        <div class="grid md:grid-cols-3 gap-6 mb-12 fade-in">
            <div class="bg-white rounded-2xl shadow-lg p-8 text-center border-2 border-purple-200">
                <div class="text-5xl mb-2">🔥</div>
                <div class="text-3xl font-black text-purple-600 mb-1">
                    <%= bmr %>
                </div>
                <div class="text-gray-600 font-semibold">BMR (Calories/day)</div>
                <div class="text-sm text-gray-500 mt-2">Base metabolic rate</div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-8 text-center border-2 border-pink-200">
                <div class="text-5xl mb-2">⚡</div>
                <div class="text-3xl font-black text-pink-600 mb-1">
                    <%= tdee %>
                </div>
                <div class="text-gray-600 font-semibold">TDEE (Calories/day)</div>
                <div class="text-sm text-gray-500 mt-2">Total daily expenditure</div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-8 text-center border-2 border-blue-200">
                <div class="text-5xl mb-2">🎯</div>
                <div class="text-3xl font-black text-blue-600 mb-1">
                    <%= targetCalories %>
                </div>
                <div class="text-gray-600 font-semibold">Target (Calories/day)</div>
                <div class="text-sm text-gray-500 mt-2">For your goal</div>
            </div>
        </div>

        <!-- Meal Plan -->
        <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12 mb-12 fade-in">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-4xl font-black text-gray-900 mb-2">🍽️ Your Meal Plan</h2>
                    <p class="text-gray-600">Personalized nutrition tailored to your needs</p>
                </div>
                <% if (allergies && allergies.length> 0) { %>
                    <div class="bg-yellow-100 px-4 py-2 rounded-lg">
                        <span class="text-sm font-semibold text-yellow-800">🚫 Avoiding: <%= allergies.join(', ') %></span>
                    </div>
                    <% } %>
                </div>
            </div>

            <div class="space-y-8">
                <% Object.keys(mealPlan).forEach((day, index) => { %>
                    <div class="border-2 border-purple-100 rounded-2xl overflow-hidden">
                        <div class="bg-purple-50 px-6 py-4 border-b border-purple-100 flex justify-between items-center">
                            <h3 class="text-xl font-bold text-purple-800 capitalize">Day <%= index + 1 %></h3>
                            <span class="text-sm font-medium text-purple-600 bg-white px-3 py-1 rounded-full shadow-sm">
                                <%= mealPlan[day].breakfast.calories + mealPlan[day].lunch.calories + mealPlan[day].dinner.calories + (mealPlan[day].snacks.calories || 0) %> kcal
                            </span>
                        </div>
                        <div class="p-6 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                            <!-- Breakfast -->
                            <div class="space-y-3">
                                <div class="flex items-center space-x-2 text-yellow-600 font-semibold">
                                    <span>🌅</span> <span>Breakfast</span>
                                </div>
                                <div class="bg-yellow-50 rounded-xl p-4 h-full">
                                    <h4 class="font-bold text-gray-900 mb-1"><%= mealPlan[day].breakfast.name %></h4>
                                    <p class="text-xs text-gray-500 mb-3"><%= mealPlan[day].breakfast.description %></p>
                                    <div class="flex flex-wrap gap-1 mb-3">
                                        <% mealPlan[day].breakfast.ingredients.forEach(ing => { %>
                                            <span class="text-xs bg-white px-2 py-1 rounded border border-yellow-100 text-gray-600"><%= ing %></span>
                                        <% }) %>
                                    </div>
                                    <div class="text-xs text-gray-500 space-y-1 border-t border-yellow-200 pt-2">
                                        <div class="flex justify-between"><span>Protein:</span> <span class="font-medium"><%= mealPlan[day].breakfast.protein %></span></div>
                                        <div class="flex justify-between"><span>Carbs:</span> <span class="font-medium"><%= mealPlan[day].breakfast.carbs %></span></div>
                                        <div class="flex justify-between"><span>Fats:</span> <span class="font-medium"><%= mealPlan[day].breakfast.fats %></span></div>
                                        <div class="flex justify-between font-semibold text-yellow-700 mt-1"><span>Calories:</span> <span><%= mealPlan[day].breakfast.calories %></span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Lunch -->
                            <div class="space-y-3">
                                <div class="flex items-center space-x-2 text-green-600 font-semibold">
                                    <span>☀️</span> <span>Lunch</span>
                                </div>
                                <div class="bg-green-50 rounded-xl p-4 h-full">
                                    <h4 class="font-bold text-gray-900 mb-1"><%= mealPlan[day].lunch.name %></h4>
                                    <p class="text-xs text-gray-500 mb-3"><%= mealPlan[day].lunch.description %></p>
                                    <div class="flex flex-wrap gap-1 mb-3">
                                        <% mealPlan[day].lunch.ingredients.forEach(ing => { %>
                                            <span class="text-xs bg-white px-2 py-1 rounded border border-green-100 text-gray-600"><%= ing %></span>
                                        <% }) %>
                                    </div>
                                    <div class="text-xs text-gray-500 space-y-1 border-t border-green-200 pt-2">
                                        <div class="flex justify-between"><span>Protein:</span> <span class="font-medium"><%= mealPlan[day].lunch.protein %></span></div>
                                        <div class="flex justify-between"><span>Carbs:</span> <span class="font-medium"><%= mealPlan[day].lunch.carbs %></span></div>
                                        <div class="flex justify-between"><span>Fats:</span> <span class="font-medium"><%= mealPlan[day].lunch.fats %></span></div>
                                        <div class="flex justify-between font-semibold text-green-700 mt-1"><span>Calories:</span> <span><%= mealPlan[day].lunch.calories %></span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dinner -->
                            <div class="space-y-3">
                                <div class="flex items-center space-x-2 text-blue-600 font-semibold">
                                    <span>🌙</span> <span>Dinner</span>
                                </div>
                                <div class="bg-blue-50 rounded-xl p-4 h-full">
                                    <h4 class="font-bold text-gray-900 mb-1"><%= mealPlan[day].dinner.name %></h4>
                                    <p class="text-xs text-gray-500 mb-3"><%= mealPlan[day].dinner.description %></p>
                                    <div class="flex flex-wrap gap-1 mb-3">
                                        <% mealPlan[day].dinner.ingredients.forEach(ing => { %>
                                            <span class="text-xs bg-white px-2 py-1 rounded border border-blue-100 text-gray-600"><%= ing %></span>
                                        <% }) %>
                                    </div>
                                    <div class="text-xs text-gray-500 space-y-1 border-t border-blue-200 pt-2">
                                        <div class="flex justify-between"><span>Protein:</span> <span class="font-medium"><%= mealPlan[day].dinner.protein %></span></div>
                                        <div class="flex justify-between"><span>Carbs:</span> <span class="font-medium"><%= mealPlan[day].dinner.carbs %></span></div>
                                        <div class="flex justify-between"><span>Fats:</span> <span class="font-medium"><%= mealPlan[day].dinner.fats %></span></div>
                                        <div class="flex justify-between font-semibold text-blue-700 mt-1"><span>Calories:</span> <span><%= mealPlan[day].dinner.calories %></span></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Snacks -->
                            <div class="space-y-3">
                                <div class="flex items-center space-x-2 text-purple-600 font-semibold">
                                    <span>🍎</span> <span>Snacks</span>
                                </div>
                                <div class="bg-purple-50 rounded-xl p-4 h-full">
                                    <h4 class="font-bold text-gray-900 mb-1"><%= mealPlan[day].snacks.name %></h4>
                                    <p class="text-xs text-gray-500 mb-3"><%= mealPlan[day].snacks.description %></p>
                                    <div class="flex flex-wrap gap-1 mb-3">
                                        <% mealPlan[day].snacks.items.forEach(item => { %>
                                            <span class="text-xs bg-white px-2 py-1 rounded border border-purple-100 text-gray-600"><%= item %></span>
                                        <% }) %>
                                    </div>
                                    <div class="text-xs text-gray-500 space-y-1 border-t border-purple-200 pt-2">
                                        <div class="flex justify-between font-semibold text-purple-700 mt-1"><span>Calories:</span> <span><%= mealPlan[day].snacks.calories %></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
        
        <!-- Workout Plan -->
        <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12 mb-12 fade-in">
            <div class="mb-8">
                <h2 class="text-4xl font-black text-gray-900 mb-2">💪 Your Workout Plan</h2>
                <p class="text-gray-600 mb-4"><%= workoutPlan.summary %></p>
                <div class="inline-block px-4 py-2 bg-purple-100 text-purple-700 rounded-lg font-semibold">
                    📅 <%= workoutPlan.weeklySchedule %>
                </div>
            </div>
            
            <div class="space-y-4">
                <% workoutPlan.exercises.forEach((exercise, index) => { %>
                <div class="border-2 border-gray-200 rounded-xl p-6 hover:border-purple-300 transition">
                    <div class="flex items-start justify-between">
                        <div class="flex-1">
                            <div class="flex items-center space-x-3 mb-2">
                                <span class="w-8 h-8 gradient-bg rounded-full flex items-center justify-center text-white font-bold text-sm">
                                    <%= index + 1 %>
                                </span>
                                <h3 class="text-xl font-bold text-gray-900"><%= exercise.name %></h3>
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-semibold capitalize">
                                    <%= exercise.type %>
                                </span>
                            </div>
                            <div class="grid grid-cols-3 gap-4 mb-3 ml-11">
                                <div>
                                    <span class="text-sm text-gray-500">Sets:</span>
                                    <span class="ml-1 font-bold text-gray-700"><%= exercise.sets %></span>
                                </div>
                                <div>
                                    <span class="text-sm text-gray-500">Reps:</span>
                                    <span class="ml-1 font-bold text-gray-700"><%= exercise.reps %></span>
                                </div>
                                <div>
                                    <span class="text-sm text-gray-500">Rest:</span>
                                    <span class="ml-1 font-bold text-gray-700"><%= exercise.rest %></span>
                                </div>
                            </div>
                            <p class="text-gray-600 ml-11"><%= exercise.notes %></p>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        
        <!-- CTA Buttons -->
        <div class="text-center space-y-4 fade-in">
            <a href="/dashboard" class="inline-block gradient-bg text-white px-12 py-5 rounded-full font-bold text-xl hover:shadow-2xl transition transform hover:scale-105">
                📊 View Your Dashboard
            </a>
            <br>
            <a href="/input" class="inline-block text-purple-600 hover:text-purple-800 font-semibold">
                Create Another Plan →
            </a>
        </div>
    </div>
    
    <footer class="bg-gray-900 text-gray-300 py-8 mt-20">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p>&copy; 2025 Nutri-Genie. Powered by Gemini 2.5 Flash AI.</p>
        </div>
    </footer>
</body>
</html>