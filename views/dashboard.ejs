<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Nutri-Genie</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800;900&display=swap"
        rel="stylesheet">

    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3 {
            font-family: 'Outfit', sans-serif;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <div class="w-10 h-10 gradient-bg rounded-lg flex items-center justify-center">
                        <span class="text-2xl">🧞</span>
                    </div>
                    <span class="text-xl font-bold gradient-text">Nutri-Genie</span>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-gray-600">Welcome, <strong>
                            <%= user.name %>
                        </strong></span>
                    <a href="/input" class="text-purple-600 hover:text-purple-800 font-medium">New Plan</a>
                    <a href="/logout" class="text-gray-500 hover:text-gray-700">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <!-- Header -->
        <div class="mb-12">
            <h1 class="text-5xl font-black text-gray-900 mb-4">
                Your <span class="gradient-text">Health Dashboard</span>
            </h1>
            <p class="text-xl text-gray-600">
                Track your progress and view your personalized health plans
            </p>
        </div>

        <!-- Stats Overview -->
        <div class="grid md:grid-cols-3 gap-6 mb-12">
            <div class="bg-white rounded-2xl shadow-lg p-8">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-4xl">📊</div>
                    <div class="text-right">
                        <div class="text-3xl font-black text-purple-600">
                            <%= stats.totalPlans %>
                        </div>
                        <div class="text-gray-600 font-semibold">Total Plans</div>
                    </div>
                </div>
                <div class="text-sm text-gray-500">Health plans generated</div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-8">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-4xl">🎯</div>
                    <div class="text-right">
                        <div class="text-3xl font-black text-pink-600">
                            <%= stats.avgCalories %>
                        </div>
                        <div class="text-gray-600 font-semibold">Avg Calories</div>
                    </div>
                </div>
                <div class="text-sm text-gray-500">Average target calories</div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-8">
                <div class="flex items-center justify-between mb-4">
                    <div class="text-4xl">🚀</div>
                    <div class="text-right">
                        <div class="text-3xl font-black text-blue-600">
                            <%= history.length> 0 ? history[0].goalType.replace('_', ' ') : 'N/A' %>
                        </div>
                        <div class="text-gray-600 font-semibold">Current Goal</div>
                    </div>
                </div>
                <div class="text-sm text-gray-500 capitalize">Your latest focus</div>
            </div>
        </div>

        <!-- History -->
        <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-3xl font-black text-gray-900">📝 Your Health History</h2>
                <a href="/input"
                    class="gradient-bg text-white px-6 py-3 rounded-full font-bold hover:shadow-lg transition">
                    + New Plan
                </a>
            </div>

            <% if (history.length===0) { %>
                <div class="text-center py-16">
                    <div class="text-6xl mb-4">🌱</div>
                    <h3 class="text-2xl font-bold text-gray-700 mb-2">Start Your Health Journey</h3>
                    <p class="text-gray-600 mb-6">You haven't created any health plans yet</p>
                    <a href="/input"
                        class="inline-block gradient-bg text-white px-8 py-4 rounded-full font-bold hover:shadow-lg transition">
                        Create Your First Plan
                    </a>
                </div>
                <% } else { %>
                    <div class="space-y-4">
                        <% history.forEach((item, index)=> { %>
                            <div
                                class="border-2 border-gray-200 rounded-2xl p-6 hover:border-purple-300 hover:shadow-lg transition">
                                <div class="flex flex-col md:flex-row md:items-center justify-between">
                                    <div class="flex-1 mb-4 md:mb-0">
                                        <div class="flex items-center space-x-3 mb-2">
                                            <span
                                                class="px-3 py-1 gradient-bg text-white rounded-full font-bold text-sm">
                                                #<%= history.length - index %>
                                            </span>
                                            <span class="font-bold text-lg text-gray-900 capitalize">
                                                <%= item.goalType.replace('_', ' ' ) %>
                                            </span>
                                            <span class="text-gray-400">•</span>
                                            <span class="text-gray-600">
                                                <%= new Date(item.createdAt).toLocaleDateString('en-US', {
                                                    month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                                            </span>
                                        </div>

                                        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mt-4">
                                            <div class="bg-gray-50 rounded-lg p-3">
                                                <div class="text-sm text-gray-500">Age</div>
                                                <div class="font-bold text-gray-900">
                                                    <%= item.age %> yrs
                                                </div>
                                            </div>
                                            <div class="bg-gray-50 rounded-lg p-3">
                                                <div class="text-sm text-gray-500">Weight</div>
                                                <div class="font-bold text-gray-900">
                                                    <%= item.weight %> kg
                                                </div>
                                            </div>
                                            <div class="bg-purple-50 rounded-lg p-3">
                                                <div class="text-sm text-purple-600">BMR</div>
                                                <div class="font-bold text-purple-700">
                                                    <%= item.bmr %>
                                                </div>
                                            </div>
                                            <div class="bg-pink-50 rounded-lg p-3">
                                                <div class="text-sm text-pink-600">TDEE</div>
                                                <div class="font-bold text-pink-700">
                                                    <%= item.tdee %>
                                                </div>
                                            </div>
                                            <div class="bg-blue-50 rounded-lg p-3">
                                                <div class="text-sm text-blue-600">Target</div>
                                                <div class="font-bold text-blue-700">
                                                    <%= item.targetCalories %>
                                                </div>
                                            </div>
                                        </div>

                                        <% if (item.allergies && item.allergies.length> 0) { %>
                                            <div class="mt-3">
                                                <span class="text-sm text-gray-500">Allergies:</span>
                                                <span class="text-sm font-semibold text-yellow-700">
                                                    <%= item.allergies.join(', ') %></span>
                            </div>
                            <% } %>
                        </div>
                        
                        <div class="flex items-center space-x-2">
                            <span class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold text-sm capitalize">
                                <%= item.activityLevel.replace(' _', ' ' ) %>
                                                </span>
                                            </div>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                            <% } %>
                    </div>

                    <!-- Tips Section -->
                    <div class="mt-12 grid md:grid-cols-3 gap-6">
                        <div class="bg-gradient-to-br from-purple-500 to-purple-700 rounded-2xl p-8 text-white">
                            <div class="text-4xl mb-4">💡</div>
                            <h3 class="text-xl font-bold mb-2">Pro Tip</h3>
                            <p class="text-purple-100">Consistency is key! Track your progress weekly to see the best
                                results.</p>
                        </div>

                        <div class="bg-gradient-to-br from-pink-500 to-pink-700 rounded-2xl p-8 text-white">
                            <div class="text-4xl mb-4">🎯</div>
                            <h3 class="text-xl font-bold mb-2">Stay Focused</h3>
                            <p class="text-pink-100">Set realistic goals and celebrate small wins along your journey.
                            </p>
                        </div>

                        <div class="bg-gradient-to-br from-blue-500 to-blue-700 rounded-2xl p-8 text-white">
                            <div class="text-4xl mb-4">📈</div>
                            <h3 class="text-xl font-bold mb-2">Track Progress</h3>
                            <p class="text-blue-100">Update your plan monthly as your body adapts to new routines.</p>
                        </div>
                    </div>
        </div>

        <footer class="bg-gray-900 text-gray-300 py-8 mt-20">
            <div class="max-w-7xl mx-auto px-4 text-center">
                <p>&copy; 2025 Nutri-Genie. Powered by Gemini 2.5 Flash AI.</p>
            </div>
        </footer>
</body>

</html>